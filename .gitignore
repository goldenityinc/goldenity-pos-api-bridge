node_modules/
.env

# Never commit npm lockfiles: Railway default strict npm ci --omit=dev hard FAILS if manifest
# and lock are out of sync after dependency upgrades (EUSAGE error class).
# Excluding the lockfile forces Railway Nixpacks to fallback to `npm install --omit=dev`,
# which auto-generates the synced lock on the Ubuntu build host (full fs permissions)
# instead of failing the build on a stale/outdated lockfile.
/package-lock.json
npm-shrinkwrap.json
yarn.lock
pnpm-lock.yaml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
