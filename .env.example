JWT_SECRET=samakan_dengan_secret_core_api
JWT_EXPIRES_IN=7d
PORT=3000
GEMINI_API_KEY=

# URL database target untuk reset script Prisma
# Contoh: postgresql://user:password@host:5432/db_tpp?sslmode=require
DATABASE_URL=

# Alternatif khusus db_tpp (opsional)
DATABASE_URL_TPP=

# Web Order Configuration - Production URL untuk dynamic QR code generation
# Contoh: https://pos-web-ordering-production.up.railway.app (production), http://localhost:3000 (development)
WEB_ORDER_URL=https://pos-web-ordering-production.up.railway.app


# S3-Compatible Object Storage (Railway)
# Required for /storage/upload and media persistence.
# AWS_* aliases are supported too if you prefer Railway environment variable names.
AWS_ENDPOINT=
AWS_REGION=auto
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional: public base URL for CDN/proxy if different from STORAGE_ENDPOINT.
STORAGE_PUBLIC_BASE_URL=

# Optional bucket prefix for QRIS payment proof uploads
PAYMENT_PROOF_BUCKET=payment-proofs

# Admin core callback for accounting auto-post (bridge -> admin-core)
ADMIN_CORE_API_BASE_URL=http://localhost:5000
ADMIN_CORE_INTERNAL_TOKEN=
ADMIN_CORE_API_TIMEOUT_MS=5000

# POS Relay Queue Configuration (STEP 2)
# Timeout dalam detik menunggu ACK dari POS device sebelum dianggap gagal
POS_ACK_TIMEOUT_SECONDS=30

# Redis URL untuk BullMQ queue engine (jika tidak diisi, otomatis fallback ke IN-MEMORY QUEUE)
# Contoh: redis://localhost:6379 atau redis://user:pass@host:port
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
